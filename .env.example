# Copy to .env and fill in. .env is gitignored — keys never get committed.
#
# CLOUD TIER AUTH — you do NOT need an API key.
# By default Continuum reaches Claude through the Claude Code CLI, reusing the
# login you already have (your Claude subscription). Nothing to set here.
#
# If you'd rather use a metered API key instead, get one from
# https://console.anthropic.com/ and set it below — Continuum will auto-prefer it.
# ANTHROPIC_API_KEY=

# Which model judges memory relationships (consolidation ADD/UPDATE/NOOP, tags,
# fact extraction). Exactly two rungs: "fast" = CONTINUUM_FAST_MODEL (Sonnet),
# "cloud" = CONTINUUM_CLOUD_MODEL (Opus — better at relationships, but a heavy
# call per durable write). Default fast.
#
# There is no "local" rung, and ANY unrecognised value resolves to cloud, not to
# the cheap tier — providers.py does that deliberately so a typo costs money
# rather than silently downgrading the model. So `CONTINUUM_REASONER=local` is
# not a no-op: it buys Opus on every durable write.
# CONTINUUM_REASONER=fast

# Optional overrides (defaults shown)
# CONTINUUM_CLOUD_PROVIDER=claude-cli   # or "anthropic" to force the API-key path
# CONTINUUM_CLAUDE_CLI=claude           # path/name of the Claude Code CLI
# CONTINUUM_CLOUD_MODEL=claude-opus-4-8

# Let the agent look at the screen (see_screen). Off by default — a screenshot
# is the most revealing thing on this machine.
# CONTINUUM_SCREEN=0
#
# There is ONE eye and it is the cloud model, so turning SCREEN on means the
# screenshot LEAVES THIS MACHINE. There used to be a local VLM to fall back on;
# it went when Ollama did, and nothing replaced it — so CLOUD_VISION=0 no longer
# means "stay local", it means see_screen and view_image stop working entirely.
# Every read names itself as cloud in the answer and on the event stream, and
# the daily cap fails closed rather than downgrading to anything.
# CONTINUUM_CLOUD_VISION=1
# CONTINUUM_CLOUD_VISION_MAX=20           # cloud image reads per day

# Let the agent read the clipboard (read_clipboard) and — with actions also on —
# write to it (write_clipboard). Off by default: the clipboard often holds a
# password, and writing throws away whatever you had copied.
# CONTINUUM_CLIPBOARD=0

# Actions: notify, open a URL or app, schedule, write the clipboard, control
# playback. This is the gate on Continuum *doing* things rather than only
# answering — and unlike SCREEN and CLIPBOARD above, it is ON by default. Set it
# to 0 to make the agent answer-only.
# CONTINUUM_ACTIONS=1

# Web search and page reading. On by default; without it the agent can only
# guess about anything it wasn't trained on. Only public http(s) addresses are
# reachable — localhost and private-network requests are refused, because a
# fetched page can try to talk the agent into fetching something else.
# CONTINUUM_WEB=1

# Calendar (read-only). Paste your calendar's *private* iCal address here.
# Google Calendar: Settings -> your calendar -> "Secret address in iCal format".
# Outlook and Apple have an equivalent. Anyone holding this URL can read your
# calendar, so treat it as a password: it lives only in .env, and Continuum
# never puts it in a log, an error message or an answer. Blank = no calendar.
# CONTINUUM_CALENDAR_ICS=
# CONTINUUM_CALENDAR_TZ=Europe/London

# Proactivity. A local gate decides whether anything changed enough to be worth
# a model call; FLOOR is the "check in anyway" ceiling, SIGNIFICANCE the score
# a change must clear to buy a call early. Raise SIGNIFICANCE to be quieter.
# CONTINUUM_PROACTIVE=0
# CONTINUUM_PROACTIVE_SECONDS=300         # earliest a change may buy a call
# CONTINUUM_PROACTIVE_FLOOR=1800          # call at least this often regardless
# CONTINUUM_PROACTIVE_SIGNIFICANCE=1.0    # gate threshold
# CONTINUUM_PROACTIVE_COOLDOWN=1800       # gap between messages actually sent

# Swedish vocab (the Flashcards tab). Both of these are credentials: they live
# here and nowhere else — not in code, not in a log line, not in an answer.
# Without them the tab still studies the cards you already have; only importing
# and generating audio go dark, and each says which key is missing.
#
# OpenRouter turns a pasted word list into full inflection tables.
# https://openrouter.ai/keys
# CONTINUUM_OPENROUTER_KEY=
#
# ElevenLabs speaks the forms worth hearing. https://elevenlabs.io/
# CONTINUUM_ELEVENLABS_KEY=

# Which model builds the inflection tables (an OpenRouter model id).
# CONTINUUM_VOCAB_MODEL=anthropic/claude-sonnet-4.5
# CONTINUUM_TTS_MODEL=eleven_multilingual_v2

# Voices. Voice ids are public identifiers, not secrets, so these ship as
# defaults and need no entry here. Two per card on purpose: andreas is
# Gothenburg-natural, anders is standard and clear. Format is
# `label:voice_id,label:voice_id`; a typo costs you the override, not all audio.
# CONTINUUM_TTS_VOICES=andreas:zA8eaG1JhG82rhuCip6v,anders:DSL3PSQNPbkOavwmnYl1

# Food database (the Nutrition tab's lookup, and the agent's food_search).
# Both entries here are credentials — .env and nowhere else.
#
# USDA FoodData Central. Free key: https://fdc.nal.usda.gov/api-key-signup.html
# LEAVING THIS BLANK IS NOT THE SAME AS TURNING IT OFF: it falls back to USDA's
# shared DEMO_KEY, which is rate-limited hard and shared with the whole internet,
# so lookups start failing under load rather than saying they aren't configured.
# CONTINUUM_FDC_KEY=
#
# FatSecret is preferred over USDA when both halves are set, and is what gets you
# branded and restaurant items. https://platform.fatsecret.com/  Set neither and
# you simply stay on USDA — /api/nutrition/food/status reports which is live.
# CONTINUUM_FATSECRET_ID=
# CONTINUUM_FATSECRET_SECRET=

# CAPABILITY GATES THAT DEFAULT *ON*. The three above (SCREEN, CLIPBOARD,
# ACTIONS) default off and are the ones people look for; these default on and
# are the ones that matter more. Listed here so the fence is visible — each is
# deliberate, not an oversight.
# CONTINUUM_TOOLS=1        # the tool loop at all; 0 makes the agent answer-only
# CONTINUUM_DEV_TOOLS=1    # read and EDIT its own source (self-development)
# CONTINUUM_SHELL=1        # arbitrary shell on this machine; this gate is the
#                          # only fence in front of it

# Routines and their reminders.
# CONTINUUM_ROUTINE_REMINDERS=1
# CONTINUUM_ROUTINE_REMINDER_CLOUD=1        # word the nudge with the cloud tier
# CONTINUUM_ROUTINE_GRACE_MIN=45            # late-by minutes before nudging
# CONTINUUM_ROUTINE_QUIET_START=23          # hours, fractional (6.5 = 06:30)
# CONTINUUM_ROUTINE_QUIET_END=6.5
# CONTINUUM_ROUTINE_AUTOSTART=1
# CONTINUUM_ROUTINE_AUTOSTART_DELAY_MIN=15

# Models and cadence.
# CONTINUUM_FAST_MODEL=claude-sonnet-5              # the cheap cloud tier
# CONTINUUM_EMBED_MODEL=BAAI/bge-small-en-v1.5      # memory search embeddings
# CONTINUUM_HEARTBEAT_SECONDS=15                    # background tick
# CONTINUUM_PROACTIVE_TIER=cloud                    # which tier words a nudge
# CONTINUUM_MEMORY_AUTOEXTRACT=1                    # pull facts out of chats

# Desk machine's MAC address, for wake-on-LAN. Blank = no wake.
# CONTINUUM_DESK_MAC=

# Storage paths. Every per-domain database and the upload directory can be
# moved with CONTINUUM_<DOMAIN>_DB / CONTINUUM_UPLOADS_DIR (MEMORY, NUTRITION,
# WORKOUTS, BODY, HEALTH, ROUTINES, SCHEDULER, MESSAGES, CONVERSATIONS,
# ACTIVITY, LEDGER, BUDGET, FLASHCARDS). They default under ./data and normally
# want leaving alone — the test suites use them to sandbox onto a temp dir.
